# Copy to .env and fill in. Never commit .env.

# Key Open WebUI (and any other client) must send to the gateway. Comma-separate for several keys.
# Generate one with:  openssl rand -hex 32
API_KEY=change-me

# AWS region that has Bedrock Mantle (e.g. us-east-1, us-west-2, eu-west-1, eu-central-1, ap-northeast-1)
AWS_REGION=us-east-1

# Option A: a Bedrock API key (Bedrock console -> API keys)
AWS_BEARER_TOKEN_BEDROCK=

# Option B: leave AWS_BEARER_TOKEN_BEDROCK empty and give the container IAM credentials instead
# (short-term Bedrock tokens are minted from them automatically):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default        # with ~/.aws mounted (see docker-compose.yml)

# Optional tuning
# REASONING_FORMAT=reasoning_content   # reasoning_content | think_tags | none
# MODEL_DISCOVERY=true
# CLAUDE_PROMPT_CACHING=false
# LOG_LEVEL=INFO
